{
  "info": {
    "_postman_id": "fd3c9546-872a-4d61-9adb-63aab9361ea0",
    "name": "Caching proxy (http.cat)",
    "description": "Тести кешуючого проксі-сервера. Запуск сервера: node main.js -h 127.0.0.1 -p 3000 -c ./cache. Порядок запитів важливий: колекція починає з порожнього кешу і в кінці (крок 5) прибирає за собою, тому повторний запуск дає ті самі результати.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET — картинки немає в кешi (з http.cat)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код стану 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type: image/jpeg\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\"));",
              "pm.test(\"X-Image-Source: http.cat\", () => pm.expect(pm.response.headers.get(\"X-Image-Source\")).to.eql(\"http.cat\"));",
              "pm.test(\"Тіло не порожнє\", () => pm.expect(pm.response.responseSize).to.be.above(0));",
              "",
              "pm.collectionVariables.set(\"originalSize\", pm.response.headers.get(\"Content-Length\"));",
              "pm.collectionVariables.set(\"firstTime\", pm.response.responseTime);",
              "console.log(\"Перший GET (http.cat):\", pm.response.responseTime, \"мс\");"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{code}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{code}}"
          ]
        },
        "description": "Перед запуском тека кешу має бути порожньою (або без файлу {{code}}.jpg)."
      }
    },
    {
      "name": "2. GET — повторний (з кешу)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код стану 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type: image/jpeg\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\"));",
              "pm.test(\"X-Image-Source: cache\", () => pm.expect(pm.response.headers.get(\"X-Image-Source\")).to.eql(\"cache\"));",
              "pm.test(\"Тіло не порожнє\", () => pm.expect(pm.response.responseSize).to.be.above(0));",
              "",
              "pm.test(\"Та сама картинка, що й з http.cat\", () =>",
              "  pm.expect(pm.response.headers.get(\"Content-Length\")).to.eql(pm.collectionVariables.get(\"originalSize\")));",
              "pm.test(\"З кешу швидше, ніж з http.cat\", () =>",
              "  pm.expect(pm.response.responseTime).to.be.below(Number(pm.collectionVariables.get(\"firstTime\"))));",
              "console.log(\"Повторний GET (кеш):\", pm.response.responseTime, \"мс\");"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{code}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{code}}"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "3. PUT — власна картинка",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код стану 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "image/jpeg"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/{{code}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{code}}"
          ]
        },
        "description": "Тіло — binary: файл test-images/my-cat.jpg з репозиторію. Якщо Postman не знаходить файл — виберіть його вручну у вкладці Body → binary.",
        "body": {
          "mode": "file",
          "file": {
            "src": "test-images/my-cat.jpg"
          }
        }
      }
    },
    {
      "name": "4. GET — після PUT (моя картинка)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код стану 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Content-Type: image/jpeg\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"image/jpeg\"));",
              "pm.test(\"X-Image-Source: cache\", () => pm.expect(pm.response.headers.get(\"X-Image-Source\")).to.eql(\"cache\"));",
              "pm.test(\"Тіло не порожнє\", () => pm.expect(pm.response.responseSize).to.be.above(0));",
              "",
              "pm.test(\"Повертається моя картинка, а не з http.cat\", () =>",
              "  pm.expect(pm.response.headers.get(\"Content-Length\")).to.not.eql(pm.collectionVariables.get(\"originalSize\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{code}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{code}}"
          ]
        },
        "description": ""
      }
    },
